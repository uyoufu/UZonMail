<Application x:Class="UzonMailDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:UzonMailDesktop.Views"
             xmlns:vm="clr-namespace:UzonMailDesktop.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                <view:StartupView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
                <view:BrowserView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
